{
  "name": "mn-pos",
  "version": "1.0.0",
  "description": "نظام نقاط البيع وإدارة المبيعات",
  "author": "Mohamed",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.mnpos.app",
    "productName": "MN POS",
    "directories": {
      "output": "dist"
    },
    "win": {
  "icon": "./icon.ico",
  "target": [
    {
      "target": "nsis",
      "arch": [
        "x64"
      ]
    }
  ]
},
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  }
}